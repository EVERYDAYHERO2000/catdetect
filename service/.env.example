# Необязательные переменные сервиса. Реальный файл кладите ВНЕ Яндекс Диска:
#   macOS/Linux: ~/.config/catdetect/.env     Docker (Windows): C:\catdetect-data\.env
#
# CATDETECT_DATA_DIR=~/catdetect-data      # БД, кадры, модели (в Docker — /data)
# CATDETECT_COMPUTE=auto                   # auto | cpu | gpu (можно сменить в веб-интерфейсе)
# CATDETECT_INFERENCE_FORMAT=openvino      # формат модели на процессоре: openvino | onnx | torch
# CATDETECT_BASE_DETECTOR=yolo26m.pt       # базовая модель детектора (n/s/m/l/x)
# CATDETECT_BASE_CLASSIFIER=yolo26s-cls.pt
# CATDETECT_COOKIE_SECURE=1                # если интерфейс открыт через HTTPS-прокси
